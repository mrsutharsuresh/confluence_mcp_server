.vscode/launch.json
.vscode/tasks.json
.vscode/*.code-workspace
.idea/
*.swp
*.swo

# ── Test & coverage ───────────────────────────────────────────────────────────
coverage/
.nyc_output/
*.lcov

# ── Logs ──────────────────────────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-error.log*

